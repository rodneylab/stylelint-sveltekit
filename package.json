{
	"name": "stylelint-sveltekit",
	"version": "0.0.1",
	"license": "BSD-3-Clause",
	"description": "Stylelint for SvelteKit: keep you Svelte code consistent and make sure your CSS and SCSS code follows your team's style guide to the letter!",
	"scripts": {
		"dev": "vite dev",
		"start": "vite dev",
		"build": "vite build",
		"check": "svelte-check",
		"preview": "vite preview",
		"lint": "prettier --ignore-path .gitignore --check --plugin=prettier-plugin-svelte . && eslint .",
		"lint:scss": "stylelint \"src/**/*.{css,scss,svelte}\"",
		"prettier:check": "prettier --check --plugin=prettier-plugin-svelte .",
		"format": "prettier --ignore-path .gitignore --write --plugin=prettier-plugin-svelte ."
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^19.8.0",
		"@eslint/js": "^9.24.0",
		"@fontsource/hind": "^5.2.5",
		"@fontsource/montserrat": "^5.2.5",
		"@sveltejs/kit": "^2.20.5",
		"commitlint": "^19.8.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.5.1",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"postcss": "^8.5.3",
		"postcss-html": "^1.8.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"sass": "^1.86.3",
		"sass-embedded": "^1.86.3",
		"stylelint": "^16.18.0",
		"stylelint-config-recommended-scss": "^14.1.0",
		"stylelint-config-standard": "^38.0.0",
		"stylelint-scss": "^6.11.1",
		"svelte": "^5.25.10",
		"svelte-check": "^4.1.5",
		"svelte-preprocess": "^6.0.3",
		"typescript-eslint": "^8.29.1",
		"vite": "^6.2.5"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/rodneylab/stylelint-sveltekit"
	},
	"bugs": {
		"url": "https://github.com/rodneylab/stylelint-sveltekit/issues"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/vite-plugin-svelte": "^5.0.3"
	}
}
